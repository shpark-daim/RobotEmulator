<Window x:Class="Robot2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Robot2"
        Title="MQTT Robot Mover" Height="520" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 제어 패널 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#f0f0f0" Margin="10">
            <Button Name="ConnectButton" Content="MQTT 연결" Width="100" Height="20" Margin="5"/>
            <TextBlock Text="상태:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBlock Name="StatusText" Text="연결 안됨" Width="80" VerticalAlignment="Center" Foreground="Red"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AutoButton" Content="Auto" Width="60" Height="20" Margin="5,0"
                        Background="LightBlue" BorderBrush="SlateGray"/>
                <Button x:Name="ManualButton" Content="Manual" Width="60" Height="20" Margin="5,0"
                        Background="LightYellow" BorderBrush="Orange"/>
            </StackPanel>
        </StackPanel>

        <!-- 메인 화면 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <!-- 레이블 컬럼: 헤더(버튼25+그래프영역75=100) 만큼 상단 여백 -->
            <StackPanel Grid.Column="0" Margin="0,100,10,0">
                <TextBlock Text="Mode" Height="25" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="State" Height="25" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="CompleteReason" Height="25" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Job" Height="25" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Recipe" Height="25" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Seq" Height="25" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="EventSeq" Height="25" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="ProductResultOk" Height="25" VerticalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="InfiniteRun" Height="25" VerticalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <local:RobotPanel x:Name="EQ2" Grid.Column="1" RobotName="EQ2" Margin="5,0"
                              ModeButtonClicked="EQnModeButtonClicked"
                              ProductResultChanged="EQnProductResultChanged"/>
            <local:RobotPanel x:Name="EQ3" Grid.Column="2" RobotName="EQ3" Margin="5,0"
                              ModeButtonClicked="EQnModeButtonClicked"
                              ProductResultChanged="EQnProductResultChanged"/>
            <local:RobotPanel x:Name="EQ1" Grid.Column="3" RobotName="EQ1" Margin="5,0"
                              ModeButtonClicked="EQnModeButtonClicked"
                              ProductResultChanged="EQnProductResultChanged"/>
            <local:RobotPanel x:Name="EQ4" Grid.Column="4" RobotName="EQ4" Margin="5,0"
                              ModeButtonClicked="EQnModeButtonClicked"
                              ProductResultChanged="EQnProductResultChanged"/>
        </Grid>
    </Grid>
</Window>
